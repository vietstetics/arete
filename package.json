{
  "name": "jarvis-fitness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JARVIS fitness app — static web app wrapped with Capacitor for native phone step tracking.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "test:steps": "node --test \"features/steps/__tests__/*.test.js\"",
    "test:health": "node --test \"features/health/__tests__/*.test.js\"",
    "typecheck": "tsc -p tsconfig.health.json",
    "test:training": "node --test \"features/training/__tests__/*.test.js\"",
    "test:muscles": "node --test \"features/muscles/__tests__/*.test.js\"",
    "test:exercises": "node --test \"features/exercises/__tests__/*.test.js\"",
    "test:machines": "node --test \"features/machines/__tests__/*.test.js\"",
    "build:machines": "node scripts/build-machine-db.mjs",
    "build:muscles": "node scripts/build-muscle-db.mjs",
    "test:standard": "node --test \"features/standard/__tests__/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.5.0"
  }
}
